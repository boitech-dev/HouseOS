# REFERENCE ONLY: adapt all paths, users, runtime IDs and bind addresses before installation.
[Unit]
Description=HouseOS voice
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/house-storage/houseos

[Service]
User=houseos
Group=houseos
WorkingDirectory=/opt/houseos/state/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/opt/houseos/state/venvs/voice/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/houseos/state/venvs/voice/lib/python3.12/site-packages/nvidia/cudnn/lib
Environment=HF_HUB_OFFLINE=1
Environment=HOME=/opt/houseos/state/run
Environment=HOUSEOS_RUNTIME_ROOT=/opt/houseos/state
ExecStartPre=/opt/houseos/state/venvs/app/bin/python /opt/houseos/state/current/deploy/mount_check.py
ExecStart=/opt/houseos/state/venvs/voice/bin/python -m houseos.voice
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=read-only
# YOUR_PRIVATE_DIRS: folders this service must never see (your SSH keys, backups, …).
InaccessiblePaths=YOUR_PRIVATE_DIRS
ReadWritePaths=/opt/houseos/state/run
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
LimitCORE=0
MemoryMax=6G
Nice=5
TasksMax=128

[Install]
WantedBy=multi-user.target
