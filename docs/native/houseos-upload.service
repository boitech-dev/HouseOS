# REFERENCE ONLY: adapt all paths, users, runtime IDs and bind addresses before installation.
[Unit]
Description=HouseOS upload
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/house-storage/houseos

[Service]
User=houseos
Group=houseos
WorkingDirectory=/opt/houseos/state/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/opt/houseos/state/run
Environment=HOUSEOS_RUNTIME_ROOT=/opt/houseos/state
ExecStartPre=/opt/houseos/state/venvs/app/bin/python /opt/houseos/state/current/deploy/mount_check.py
ExecStart=/opt/houseos/state/bin/tusd -host 127.0.0.1 -port 8992 -upload-dir /mnt/house-storage/houseos/staging -disable-download -disable-concatenation -disable-cors -max-size 85899345920 -file-perms 600 -dir-perms 700 -verbose=false -expose-metrics=false -show-greeting=false
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=read-only
# YOUR_PRIVATE_DIRS: folders this service must never see (your SSH keys, backups, …).
InaccessiblePaths=YOUR_PRIVATE_DIRS
ReadWritePaths=/mnt/house-storage/houseos/staging
BindPaths=/mnt/house-storage/houseos/staging
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
LimitCORE=0
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
