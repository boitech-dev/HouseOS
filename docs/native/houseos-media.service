# REFERENCE ONLY: adapt all paths, users, runtime IDs and bind addresses before installation.
[Unit]
Description=HouseOS media
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/house-storage/houseos

[Service]
User=houseos
Group=houseos
WorkingDirectory=/opt/houseos/state/current/backend
EnvironmentFile=/etc/houseos/houseos.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/opt/houseos/state/run
Environment=HOUSEOS_RUNTIME_ROOT=/opt/houseos/state
ExecStartPre=/opt/houseos/state/venvs/app/bin/python /opt/houseos/state/current/deploy/mount_check.py
# At boot the LAN address may arrive after network-online: wait for it (60 s) instead of crash-looping.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do ip -4 -o addr show | grep -qwF 192.0.2.24 && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/houseos/state/venvs/app/bin/python -m uvicorn houseos.relay:app --host 192.0.2.24 --port 8991 --no-access-log --log-level warning
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=read-only
# YOUR_PRIVATE_DIRS: folders this service must never see (your SSH keys, backups, …).
InaccessiblePaths=YOUR_PRIVATE_DIRS
ReadWritePaths=/opt/houseos/state/run /opt/houseos/state/audio /opt/houseos/state/transcode /opt/houseos/state/cinema /mnt/house-storage/houseos
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
LimitCORE=0
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
