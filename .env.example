# Copy to .env next to docker-compose.yml. Everything is optional: without a .env, HouseOS
# starts with safe defaults and you set the rest up in the app (Control Room → Setup).

# Database password inside Docker (the database is never reachable from your network).
# Change it before the first start; afterwards it lives in the database volume.
HOUSEOS_DB_PASSWORD=change-me-houseos-db

# --- Only if you need them ------------------------------------------------------------
# The built-in HTTPS door (phones, voice, app install): https://houseos.local:8443
# HOUSEOS_HTTPS_PORT=8443
# This computer's address on your home network, when a VPN or a Tailscale exit node carries
# its internet traffic (TVs and speakers are then given the wrong address).
# HOUSEOS_LAN_ADDRESS=192.168.1.20
# The name HouseOS announces on your network (houseos.local); empty turns it off.
# HOUSEOS_MDNS_NAME=houseos
# Voice typing's speech model on the processor: "base" on a Raspberry Pi or under 6 GB of
# memory, "small" otherwise.
# HOUSEOS_VOICE_MODEL=small
# HouseOS as its own device with its own address on your network (docs/DOCKER.md):
# `./houseos.sh own-address` writes these lines.
# COMPOSE_FILE=docker-compose.yml:compose.lan.yml
# HOUSEOS_LAN_PARENT=wlan0
# HOUSEOS_LAN_SUBNET=192.168.1.0/24
# HOUSEOS_LAN_GATEWAY=192.168.1.1
# HOUSEOS_LAN_IP=192.168.1.250
# Plain HTTP on 8990 is for this computer only; 0.0.0.0 lets a reverse proxy on another
# machine reach it (then also set HOUSEOS_FORWARDED_ALLOW_IPS to that proxy's address).
# HOUSEOS_BIND=127.0.0.1
# HOUSEOS_FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# Extra addresses to trust from the start (the one you set up with is trusted by itself;
# add others later in Control Room → Access).
# HOUSEOS_ALLOWED_ORIGINS=https://house.example.lan
# An NVIDIA card for voice typing (needs the NVIDIA Container Toolkit): `./houseos.sh gpu on`
# writes this line. The Control Room buttons (`./houseos.sh buttons on`) add compose.helper.yml.
# COMPOSE_FILE=docker-compose.yml:compose.gpu.yml
