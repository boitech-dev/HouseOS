{
  "$description": "Base: every token HouseOS has, with a quiet neutral look. Other themes change only what differs. Colours may be written as #hex or oklch(L C H); {references} point at other tokens.",
  "seed": {
    "$type": "color",
    "$description": "The theme's source colours. Each makes a 12-step ramp (ramp.<name>.1–12) for the scheme: 1–2 app backgrounds, 3–5 component backgrounds, 6–8 borders, 9–10 solid fills (9 is the seed itself), 11 low-contrast text, 12 high-contrast text.",
    "neutral": { "$value": "oklch(0.55 0.02 255)", "$description": "Greys for grounds, text and lines; a hint of hue makes them feel chosen" },
    "accent": { "$value": "oklch(0.64 0.085 195)", "$description": "The one colour that means \"act here\" or \"this is on\"" },
    "success": { "$value": "oklch(0.66 0.12 150)", "$description": "Done, ready, playing" },
    "warning": { "$value": "oklch(0.78 0.13 80)", "$description": "Needs a look soon" },
    "danger": { "$value": "oklch(0.62 0.17 25)", "$description": "Failed, destructive" },
    "info": { "$value": "oklch(0.66 0.1 245)", "$description": "Neutral news" },
    "private": { "$value": "oklch(0.66 0.11 305)", "$description": "Private or personal things (My Space, Nox's familiar)" }
  },
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{ramp.neutral.1}", "$description": "The page ground" },
      "surface": { "$value": "{ramp.neutral.2}", "$description": "Sections, rails and cards that need a ground" },
      "raised": { "$value": "{ramp.neutral.3}", "$description": "Buttons, the Now bar, popovers" },
      "overlay": { "$value": "{ramp.neutral.2}", "$description": "Sheets, dialogs and menus" },
      "sunken": { "$value": "{ramp.neutral.1}", "$description": "Inputs and insets" },
      "inverse": { "$value": "{ramp.neutral.12}", "$description": "Toasts and tooltips" },
      "hover": { "$value": "{ramp.neutral.4}", "$description": "Something under the pointer" },
      "pressed": { "$value": "{ramp.neutral.5}", "$description": "Something being pressed" },
      "selected": { "$value": "{ramp.accent.4}", "$description": "The chosen item in a list, tab or chip group" },
      "current": { "$value": "{color.bg.selected}", "$description": "Where you are: the rail's room, the settings menu's page (a solid block with fg.current for an inverted look)" }
    },
    "fg": {
      "default": { "$value": "{ramp.neutral.12}", "$description": "Body text and icons" },
      "muted": { "$value": "{ramp.neutral.11}", "$description": "Secondary text" },
      "subtle": { "$value": "{ramp.neutral.11}", "$description": "Meta text (times, counts)" },
      "placeholder": { "$value": "{ramp.neutral.11}", "$description": "Hints inside empty fields" },
      "disabled": { "$value": "{ramp.neutral.8}", "$description": "Controls that can't be used now" },
      "inverse": { "$value": "{ramp.neutral.1}", "$description": "Text on bg.inverse" },
      "on-accent": { "$value": "contrast({color.accent.solid})", "$description": "Text on accent.solid" },
      "link": { "$value": "{ramp.accent.11}", "$description": "Links in text" },
      "current": { "$value": "{color.fg.default}", "$description": "Text on bg.current" }
    },
    "border": {
      "subtle": { "$value": "{ramp.neutral.6}", "$description": "Dividers between list rows" },
      "default": { "$value": "{ramp.neutral.7}", "$description": "Edges of surfaces" },
      "strong": { "$value": "{ramp.neutral.8}", "$description": "Edges of controls (at least 3:1 on grounds)" }
    },
    "focus-ring": { "$value": "{ramp.accent.9}", "$description": "The keyboard focus outline (at least 3:1 everywhere)" },
    "accent": {
      "solid": { "$value": "{ramp.accent.9}", "$description": "Primary buttons, the active tab mark, progress" },
      "solid-hover": { "$value": "{ramp.accent.10}", "$description": "The same, under the pointer" },
      "soft": { "$value": "{ramp.accent.3}", "$description": "A quiet accent ground (selected chip)" },
      "fg": { "$value": "{ramp.accent.11}", "$description": "Accent text on grounds" },
      "border": { "$value": "{ramp.accent.7}", "$description": "Accent edges" }
    },
    "success": {
      "solid": { "$value": "{ramp.success.9}" },
      "soft": { "$value": "{ramp.success.3}" },
      "fg": { "$value": "{ramp.success.11}" },
      "border": { "$value": "{ramp.success.7}" }
    },
    "warning": {
      "solid": { "$value": "{ramp.warning.9}" },
      "soft": { "$value": "{ramp.warning.3}" },
      "fg": { "$value": "{ramp.warning.11}" },
      "border": { "$value": "{ramp.warning.7}" }
    },
    "danger": {
      "solid": { "$value": "{ramp.danger.9}" },
      "soft": { "$value": "{ramp.danger.3}" },
      "fg": { "$value": "{ramp.danger.11}" },
      "border": { "$value": "{ramp.danger.7}" }
    },
    "info": {
      "solid": { "$value": "{ramp.info.9}" },
      "soft": { "$value": "{ramp.info.3}" },
      "fg": { "$value": "{ramp.info.11}" },
      "border": { "$value": "{ramp.info.7}" }
    },
    "private": {
      "solid": { "$value": "{ramp.private.9}", "$description": "Private things: My Space, Nox's familiar" },
      "soft": { "$value": "{ramp.private.3}" },
      "fg": { "$value": "{ramp.private.11}" }
    },
    "paper": {
      "bg": { "$value": "{ramp.neutral.3}", "$description": "Wall notes, the join card, the gazette" },
      "fg": { "$value": "{ramp.neutral.12}" },
      "muted": { "$value": "{ramp.neutral.11}" }
    },
    "room": {
      "$description": "Each place's own light: an indicator (a mark, a line, a focus ring), never a fill. The shell sets data-room; --c-room, --c-room-fg, --c-room-soft and --c-room-line follow it.",
      "home": { "$value": "oklch(0.9 0.02 80)" },
      "listen": { "$value": "oklch(0.8 0.06 50)" },
      "watch": { "$value": "oklch(0.83 0.05 205)" },
      "house": { "$value": "oklch(0.8 0.06 140)" },
      "files": { "$value": "oklch(0.86 0.06 100)" },
      "ask": { "$value": "oklch(0.75 0.06 5)" },
      "me": { "$value": "oklch(0.77 0.055 320)" },
      "control": { "$value": "oklch(0.74 0.055 260)" },
      "smart-home": { "$value": "{color.room.house}", "$description": "Rooms without their own light in Base borrow a neighbour's; a theme may give each its own." },
      "inbox": { "$value": "{color.room.house}" },
      "space": { "$value": "{color.room.me}" },
      "party": { "$value": "{color.room.listen}" },
      "games": { "$value": "oklch(0.8 0.07 175)", "$description": "Its own light in every theme: a theme without one keeps Base's." }
    },
    "person": {
      "$description": "One colour per resident, on their marks only (avatar ring, their songs in the queue)",
      "1": { "$value": "oklch(0.8 0.09 70)" },
      "2": { "$value": "oklch(0.8 0.08 205)" },
      "3": { "$value": "oklch(0.8 0.09 140)" },
      "4": { "$value": "oklch(0.78 0.09 15)" },
      "5": { "$value": "oklch(0.78 0.08 305)" },
      "6": { "$value": "oklch(0.84 0.1 95)" },
      "7": { "$value": "oklch(0.78 0.08 255)" },
      "8": { "$value": "oklch(0.78 0.07 345)" }
    },
    "data": {
      "$description": "Chart series and genres",
      "1": { "$value": "{color.person.1}" },
      "2": { "$value": "{color.person.2}" },
      "3": { "$value": "{color.person.4}" },
      "4": { "$value": "{color.person.3}" },
      "5": { "$value": "{color.person.5}" },
      "6": { "$value": "{color.person.6}" },
      "7": { "$value": "{color.person.7}" },
      "8": { "$value": "{color.person.8}" }
    },
    "scrim": { "$value": "alpha({ramp.neutral.1}, 72%)", "$description": "Behind sheets and dialogs" },
    "media-scrim": { "$value": "alpha(#000000, 62%)", "$description": "Under text laid over posters and covers" },
    "shadow": { "$value": "#000000", "$description": "The colour of every shadow" },
    "sprite": {
      "$description": "The palette pixel sprites are drawn with (the letters in the grids). Changing these recolours every sprite.",
      "outline": { "$value": "{ramp.neutral.1}", "$description": "k: outlines" },
      "dark": { "$value": "{ramp.neutral.4}", "$description": "n" },
      "mid-dark": { "$value": "{ramp.neutral.7}", "$description": "l" },
      "mid": { "$value": "{ramp.neutral.8}", "$description": "L" },
      "mist": { "$value": "{ramp.neutral.11}", "$description": "m" },
      "light": { "$value": "{ramp.neutral.12}", "$description": "c" },
      "light-dim": { "$value": "{ramp.neutral.11}", "$description": "C" },
      "accent": { "$value": "{ramp.accent.9}", "$description": "e" },
      "accent-hi": { "$value": "{ramp.accent.11}", "$description": "E" },
      "accent-deep": { "$value": "{ramp.accent.7}", "$description": "r" },
      "familiar": { "$value": "{ramp.private.9}", "$description": "v: Nox" },
      "familiar-mid": { "$value": "{ramp.private.8}", "$description": "V" },
      "familiar-deep": { "$value": "{ramp.private.6}", "$description": "w" },
      "good": { "$value": "{ramp.success.9}", "$description": "g" },
      "alert": { "$value": "{ramp.danger.9}", "$description": "p" },
      "paper": { "$value": "{ramp.neutral.12}", "$description": "P" },
      "ink": { "$value": "{ramp.neutral.2}", "$description": "i" }
    },
    "scene": {
      "$description": "The painted scenes (house, rooms, poster placeholders) are drawn from these.",
      "night-0": { "$value": "{ramp.neutral.1}" },
      "night-1": { "$value": "{ramp.neutral.2}" },
      "night-2": { "$value": "{ramp.neutral.4}" },
      "line": { "$value": "{ramp.neutral.6}" },
      "line-hi": { "$value": "{ramp.neutral.8}" },
      "mist": { "$value": "{ramp.neutral.11}" },
      "cream": { "$value": "{ramp.neutral.12}" },
      "ember": { "$value": "{ramp.accent.9}" },
      "ember-hi": { "$value": "{ramp.accent.11}" },
      "ember-deep": { "$value": "{ramp.accent.7}" },
      "lilac": { "$value": "{ramp.private.9}" },
      "moss": { "$value": "{ramp.success.9}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Titles and display moments" },
    "body": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Everything people read" },
    "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Codes, times and numbers in tables" }
  },
  "text": {
    "$type": "typography",
    "$description": "The only way text is styled: a component picks a style, never a size. Each gives --text-<style> (the font shorthand), --text-<style>-tracking and --text-<style>-case.",
    "display-xl": { "$value": { "fontFamily": "{font.display}", "fontSize": 44, "fontWeight": 600, "lineHeight": 1.1, "letterSpacing": -0.01 } },
    "display-l": { "$value": { "fontFamily": "{font.display}", "fontSize": 34, "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": -0.01 } },
    "display-m": { "$value": { "fontFamily": "{font.display}", "fontSize": 27, "fontWeight": 600, "lineHeight": 1.2 } },
    "brand": { "$value": { "fontFamily": "{font.display}", "fontSize": 18, "fontWeight": 600, "lineHeight": 1.2 }, "$description": "The house's name in the status bar and the rail" },
    "title-l": { "$value": { "fontFamily": "{font.body}", "fontSize": 22, "fontWeight": 600, "lineHeight": 1.25 } },
    "title-m": { "$value": { "fontFamily": "{font.body}", "fontSize": 18, "fontWeight": 600, "lineHeight": 1.3 } },
    "title-s": { "$value": { "fontFamily": "{font.body}", "fontSize": 16, "fontWeight": 600, "lineHeight": 1.3 } },
    "body-l": { "$value": { "fontFamily": "{font.body}", "fontSize": 18, "fontWeight": 400, "lineHeight": 1.5 } },
    "body-m": { "$value": { "fontFamily": "{font.body}", "fontSize": 16, "fontWeight": 400, "lineHeight": 1.5 } },
    "body-s": { "$value": { "fontFamily": "{font.body}", "fontSize": 14, "fontWeight": 400, "lineHeight": 1.45 } },
    "action": { "$value": { "fontFamily": "{font.body}", "fontSize": 15, "fontWeight": 500, "lineHeight": 1.2 }, "$description": "Buttons, tabs, chips" },
    "label": { "$value": { "fontFamily": "{font.body}", "fontSize": 13, "fontWeight": 500, "lineHeight": 1.2, "letterSpacing": 0.01 }, "$description": "Field labels and small headings" },
    "caption": { "$value": { "fontFamily": "{font.body}", "fontSize": 12, "fontWeight": 450, "lineHeight": 1.35, "letterSpacing": 0.01 } },
    "numeric": { "$value": { "fontFamily": "{font.mono}", "fontSize": 14, "fontWeight": 450, "lineHeight": 1.2 } }
  },
  "space": {
    "$type": "dimension",
    "$description": "The spacing scale, the same in every theme (contract). Use it for every gap, padding and margin.",
    "1": { "$value": 4 },
    "2": { "$value": 8 },
    "3": { "$value": 12 },
    "4": { "$value": 16 },
    "5": { "$value": 24 },
    "6": { "$value": 32 },
    "7": { "$value": 48 },
    "8": { "$value": 64 }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": 0 },
    "xs": { "$value": 3 },
    "s": { "$value": 6 },
    "m": { "$value": 10 },
    "l": { "$value": 14 },
    "xl": { "$value": 20 },
    "full": { "$value": 999 },
    "control": { "$value": "{radius.s}", "$description": "Buttons, fields" },
    "card": { "$value": "{radius.m}", "$description": "Surfaces" },
    "sheet": { "$value": "{radius.l}", "$description": "Sheets and dialogs" },
    "chip": { "$value": "{radius.full}", "$description": "Chips and badges" },
    "media": { "$value": "{radius.s}", "$description": "Posters and covers" },
    "avatar": { "$value": "{radius.full}", "$description": "People" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": 1 },
    "default": { "$value": 1 },
    "strong": { "$value": 2 }
  },
  "shape": {
    "cut": { "$type": "string", "$value": "none", "$description": "An optional clip-path for cut or notched corners on surfaces (none by default)" }
  },
  "elev": {
    "$type": "shadow",
    "$description": "Depth, from flat to floating; complete box-shadow values.",
    "0": { "$value": "none" },
    "1": { "$value": "0 1px 2px alpha({color.shadow}, 30%)" },
    "2": { "$value": "0 2px 8px alpha({color.shadow}, 32%)" },
    "3": { "$value": "0 8px 24px alpha({color.shadow}, 38%)" },
    "4": { "$value": "0 16px 48px alpha({color.shadow}, 45%)" }
  },
  "material": {
    "$description": "Surface recipes. Components ask for a material, never a colour: a theme that says \"carved stone\" or \"linen paper\" edits these.",
    "canvas": {
      "bg": { "$type": "color", "$value": "{color.bg.canvas}" },
      "texture": { "$type": "string", "$value": "none", "$description": "An optional tiling image, url(...) from the theme's art/" }
    },
    "surface": {
      "bg": { "$type": "color", "$value": "{color.bg.surface}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.subtle}" },
      "shadow": { "$type": "shadow", "$value": "none" },
      "radius": { "$type": "dimension", "$value": "{radius.card}" },
      "texture": { "$type": "string", "$value": "none" }
    },
    "raised": {
      "bg": { "$type": "color", "$value": "{color.bg.raised}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.default}" },
      "shadow": { "$type": "shadow", "$value": "{elev.1}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" }
    },
    "overlay": {
      "bg": { "$type": "color", "$value": "{color.bg.overlay}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.default}" },
      "shadow": { "$type": "shadow", "$value": "{elev.4}" },
      "radius": { "$type": "dimension", "$value": "{radius.sheet}" },
      "blur": { "$type": "string", "$value": "none", "$description": "backdrop-filter behind sheets, e.g. blur(12px)" }
    },
    "sunken": {
      "bg": { "$type": "color", "$value": "{color.bg.sunken}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.strong}" },
      "shadow": { "$type": "shadow", "$value": "none" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" }
    },
    "inverse": {
      "bg": { "$type": "color", "$value": "{color.bg.inverse}" },
      "fg": { "$type": "color", "$value": "{color.fg.inverse}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" }
    },
    "paper": {
      "bg": { "$type": "color", "$value": "{color.paper.bg}" },
      "fg": { "$type": "color", "$value": "{color.paper.fg}" },
      "texture": { "$type": "string", "$value": "none" },
      "shadow": { "$type": "shadow", "$value": "{elev.1}" },
      "rotate": { "$type": "string", "$value": "0deg", "$description": "Notes pinned slightly askew, e.g. 1.2deg (alternates per note)" }
    },
    "media": {
      "border": { "$type": "string", "$value": "1px solid {color.border.subtle}" },
      "radius": { "$type": "dimension", "$value": "{radius.media}" },
      "shadow": { "$type": "shadow", "$value": "{elev.1}" },
      "overlay": { "$type": "string", "$value": "linear-gradient(transparent 40%, {color.media-scrim})", "$description": "Laid over art that carries text; the art itself is never tinted" }
    },
    "screen": {
      "bg": { "$type": "color", "$value": "{color.bg.sunken}" },
      "fg": { "$type": "color", "$value": "{color.fg.default}", "$description": "Text on the screen (a dark board in a light theme needs light text)" },
      "texture": { "$type": "string", "$value": "none", "$description": "e.g. scanlines for a CRT feel" },
      "glow": { "$type": "shadow", "$value": "none" }
    }
  },
  "part": {
    "$description": "The interface's parts, each its own lego block: page, status bar, rail (wide screens), dock (phones), Now bar, page header, panel (Home's modules) and sheet. Each starts as a material (so Base and older themes look the same) and may be styled on its own. Sizes stay fixed; edges are 1px.",
    "page": {
      "bg": { "$type": "color", "$value": "{material.canvas.bg}" },
      "texture": { "$type": "string", "$value": "{material.canvas.texture}", "$description": "A tiling image over the whole page, url(art/…)" },
      "scrim": { "$type": "color", "$value": "alpha({color.bg.canvas}, 82%)", "$description": "Over the page.backdrop art, under the content: keep it strong enough for text" },
      "quiet": { "$type": "color", "$value": "transparent", "$description": "Behind quiet buttons (and toolbars' words) on the page: a fill when art shows behind the pages" },
      "ink-shadow": { "$type": "string", "$value": "none", "$description": "Under the page's own headings (titles, sections), for art behind the pages: e.g. 0 1px 3px #000" },
      "gallery": { "$type": "color", "$value": "transparent", "$description": "Behind rows and grids of posters and covers, so pictures never sit on the page's picture" }
    },
    "status": {
      "bg": { "$type": "color", "$value": "{material.canvas.bg}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.subtle}" },
      "texture": { "$type": "string", "$value": "none" },
      "art-opacity": { "$type": "string", "$value": "0.85", "$description": "How much the status.backdrop art shows (0–1)" }
    },
    "rail": {
      "bg": { "$type": "color", "$value": "{material.surface.bg}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.subtle}" },
      "texture": { "$type": "string", "$value": "none" },
      "ink-shadow": { "$type": "string", "$value": "0 1px 2px #000, 0 0 8px #000", "$description": "Under the rail's words when a rail picture (rail.surface) is behind them" }
    },
    "dock": {
      "bg": { "$type": "color", "$value": "{material.overlay.bg}" },
      "border": { "$type": "string", "$value": "1px solid {color.border.subtle}" },
      "texture": { "$type": "string", "$value": "none" }
    },
    "nowbar": {
      "bg": { "$type": "color", "$value": "{material.raised.bg}" },
      "fg": { "$type": "color", "$value": "{color.fg.default}", "$description": "Its text: a dark bar in a light theme needs light text" },
      "border": { "$type": "string", "$value": "{material.raised.border}" },
      "radius": { "$type": "dimension", "$value": "{radius.card}" },
      "shadow": { "$type": "shadow", "$value": "{elev.3}" },
      "texture": { "$type": "string", "$value": "none" }
    },
    "header": {
      "fg": { "$type": "color", "$value": "{color.fg.default}", "$description": "The page title" },
      "kicker": { "$type": "color", "$value": "{color.fg.muted}", "$description": "The words above the title when the room has no light (unified rooms)" },
      "banner-fade": { "$type": "color", "$value": "{color.bg.canvas}", "$description": "Where the header.banner art fades out, under the title" },
      "frame-bg": { "$type": "color", "$value": "{material.surface.bg}", "$description": "The framed header's box (parts.header framed)" },
      "banner-wash": { "$type": "number", "$value": 1, "$description": "How strongly the room's light tints a header banner, fading down (0–1; 0 for none)" },
      "frame-border": { "$type": "string", "$value": "{material.surface.border}", "$description": "The framed header's edge" },
      "frame-texture": { "$type": "string", "$value": "none", "$description": "Drawn over the framed header's box: a bevel or gloss (a gradient), or url(art/…)" }
    },
    "panel": {
      "bg": { "$type": "color", "$value": "{material.surface.bg}" },
      "border": { "$type": "string", "$value": "{material.surface.border}" },
      "radius": { "$type": "dimension", "$value": "{material.surface.radius}" },
      "shadow": { "$type": "shadow", "$value": "{material.surface.shadow}" },
      "texture": { "$type": "string", "$value": "{material.surface.texture}" },
      "head": { "$type": "color", "$value": "{color.fg.muted}", "$description": "A panel's icon and link line" }
    },
    "sheet": {
      "bg": { "$type": "color", "$value": "{material.overlay.bg}" },
      "border": { "$type": "string", "$value": "{material.overlay.border}" },
      "radius": { "$type": "dimension", "$value": "{material.overlay.radius}" },
      "shadow": { "$type": "shadow", "$value": "{material.overlay.shadow}" },
      "texture": { "$type": "string", "$value": "none" }
    },
    "hero": {
      "width": { "$type": "string", "$value": "60%", "$description": "Home's picture on wide screens: how much of the greeting's box it takes, from the right" },
      "fade": { "$type": "string", "$value": "40%", "$description": "How far into the picture it fades in from the words' side (of its own width)" }
    },
    "control": {
      "bg": { "$type": "string", "$value": "{material.raised.bg}", "$description": "Buttons' ground: a colour, or a gradient over one (gloss, bevel)" },
      "shadow": { "$type": "shadow", "$value": "{material.raised.shadow}", "$description": "An outlined button's shadow" },
      "primary-bg": { "$type": "string", "$value": "{color.accent.solid}", "$description": "The main button's ground: a colour, or a gradient over one" },
      "primary-shadow": { "$type": "shadow", "$value": "none", "$description": "The main button's shadow: an inset bevel, a glow" }
    },
    "meter": {
      "track": { "$type": "color", "$value": "{color.border.default}", "$description": "The empty part of a slider" },
      "pattern": { "$type": "string", "$value": "none", "$description": "Drawn over sliders and progress bars: segments, stripes or gloss (a gradient, or url(art/…))" },
      "thumb": { "$type": "color", "$value": "{color.fg.default}", "$description": "A slider's handle" },
      "thumb-radius": { "$type": "dimension", "$value": "{radius.full}", "$description": "A slider's handle: round, or 0 for a square one" }
    }
  },
  "dur": {
    "$type": "duration",
    "instant": { "$value": 0 },
    "fast": { "$value": 120 },
    "base": { "$value": 200 },
    "slow": { "$value": 320 },
    "slower": { "$value": 480 }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter": { "$value": [0, 0, 0, 1] },
    "exit": { "$value": [0.3, 0, 1, 1] },
    "emphasized": { "$value": [0.2, 0.7, 0.2, 1] }
  },
  "icon": {
    "stroke": { "$type": "number", "$value": 1.75, "$description": "Line icons' stroke width (1–2.5)" },
    "s": { "$type": "dimension", "$value": 16 },
    "m": { "$type": "dimension", "$value": 20 },
    "l": { "$type": "dimension", "$value": 24 }
  },
  "z": {
    "$type": "number",
    "$description": "Stacking order. Contract: themes can't change it.",
    "behind": { "$value": -1, "$description": "Decoration behind content, inside its own stacking context (page backdrop, header banner)" },
    "raised": { "$value": 10 },
    "sticky": { "$value": 20 },
    "dock": { "$value": 40 },
    "nowbar": { "$value": 45 },
    "overlay": { "$value": 60 },
    "toast": { "$value": 70 },
    "palette": { "$value": 80 }
  },
  "chrome": {
    "$type": "dimension",
    "$description": "Heights of the shell's bars. Contract: the same in every theme.",
    "status": { "$value": 48 },
    "nowbar": { "$value": 56 },
    "dock": { "$value": 64 },
    "rail": { "$value": 88 }
  },
  "bp": {
    "$type": "dimension",
    "$description": "Breakpoints (for reference: CSS uses these four values in @media). Contract: themes can't change them.",
    "sm": { "$value": 600 },
    "md": { "$value": 900 },
    "lg": { "$value": 1232 },
    "xl": { "$value": 1600 }
  }
}
