        "serif"
      ]
    },
    "body": {
      "$value": [
        "Instrument Sans",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "JetBrains Mono",
        "monospace"
      ]
    }
  },
  "text": {
    "$type": "typography",
    "display-xl": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 48,
        "fontWeight": 400,
        "lineHeight": 1.05,
        "letterSpacing": -0.005
      }
    },
    "display-l": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 37,
        "fontWeight": 400,
        "lineHeight": 1.08,
        "letterSpacing": -0.005
      }
    },
    "display-m": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 29,
        "fontWeight": 400,
        "lineHeight": 1.12
      }
    },
    "brand": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 15,
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": 0.18,
        "textTransform": "uppercase"
      }
    },
    "title-l": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 23,
        "fontWeight": 400,
        "lineHeight": 1.25,
        "letterSpacing": 0.005
      }
    },
    "title-m": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 18,
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": -0.005
      }
    },
    "title-s": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 16,
        "fontWeight": 600,
        "lineHeight": 1.3
      }
    },
    "body-m": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 16,
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 13,
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": 0.03
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 12,
        "fontWeight": 400,
        "lineHeight": 1.35,
        "letterSpacing": 0.02
      }
    },
    "numeric": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": 13,
        "fontWeight": 400,
        "lineHeight": 1.3
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.xs}"
    },
    "card": {
      "$value": "{radius.xs}"
    },
    "sheet": {
      "$value": "{radius.s}"
    },
    "chip": {
      "$value": "{radius.full}"
    },
    "media": {
      "$value": "{radius.xs}"
    },
    "avatar": {
      "$value": "{radius.full}"
    }
  },
  "material": {
    "surface": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.subtle}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "raised": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.default}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "overlay": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.default}"
      }
    },
    "sunken": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.strong}"
      }
    },
    "media": {
      "border": {
        "$type": "string",
        "$value": "1px solid transparent"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "paper": {
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "screen": {
      "bg": {
        "$type": "color",
        "$value": "#000000"
      }
    }
  },
  "part": {
    "hero": {
      "width": { "$value": "75%", "$description": "The panorama at full height: the box never gets wider than the picture, so it is never zoomed" },
      "fade": { "$value": "45%", "$description": "Its right (the cathedral) dissolves under the words; its left stays in full light" }
    },
    "status": {
      "bg": {
        "$type": "color",
        "$value": "#000000"
      },
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.subtle}"
      }
    },
    "rail": {
      "bg": {
        "$type": "color",
        "$value": "#000000"
      },
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.subtle}"
      }
    },
    "dock": {
      "bg": {
        "$type": "color",
        "$value": "#000000"
      },
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.default}"
      }
    },
    "nowbar": {
      "bg": {
        "$type": "color",
        "$value": "#000000"
      },
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.strong}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.xs}"
      }
    },
    "header": {
      "kicker": {
        "$type": "color",
        "$value": "{color.fg.muted}"
      },
      "frame-bg": {
        "$type": "color",
        "$value": "alpha(#000000, 84%)",
        "$description": "The page title's wall label: black, over the fresque"
      },
      "frame-border": {
        "$type": "string",
        "$value": "1px solid alpha(#f2eee6, 48%)",
        "$description": "A bone hairline around the title's label"
      }
    },
    "sheet": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.default}"
      }
    },
    "page": {
      "scrim": {
        "$type": "color",
        "$value": "alpha(#000000, 25%)",
        "$description": "The saints fresque is already at half light (cut.py): a little more, so it reads as a wall behind the work"
      },
      "quiet": {
        "$type": "color",
        "$value": "alpha(#000000, 78%)",
        "$description": "Quiet buttons and toolbars on the page: small black plaques over the fresque"
      },
      "ink-shadow": {
        "$type": "string",
        "$value": "0 1px 2px #000000, 0 0 12px #000000",
        "$description": "The page's headings over the fresque: a dark edge, not a glow"
      },
      "gallery": {
        "$type": "color",
        "$value": "#050505",
        "$description": "Posters and covers hang on black, never picture on picture"
      }
    },
    "panel": {
      "border": {
        "$type": "string",
        "$value": "1px solid alpha(#f2eee6, 14%)",
        "$description": "A faint cream hairline; the corners carry the frame"
      },
      "texture": {
        "$type": "string",
        "$value": "linear-gradient(#f2eee6, #f2eee6) top 6px left 6px / 14px 1.5px no-repeat, linear-gradient(#f2eee6, #f2eee6) top 6px left 6px / 1.5px 14px no-repeat, linear-gradient(#f2eee6, #f2eee6) top 6px right 6px / 14px 1.5px no-repeat, linear-gradient(#f2eee6, #f2eee6) top 6px right 6px / 1.5px 14px no-repeat, linear-gradient(#f2eee6, #f2eee6) bottom 6px left 6px / 14px 1.5px no-repeat, linear-gradient(#f2eee6, #f2eee6) bottom 6px left 6px / 1.5px 14px no-repeat, linear-gradient(#f2eee6, #f2eee6) bottom 6px right 6px / 14px 1.5px no-repeat, linear-gradient(#f2eee6, #f2eee6) bottom 6px right 6px / 1.5px 14px no-repeat",
        "$description": "Corner marks: four small cream brackets, like a museum mount (drawn with gradients, no image)"
      }
    }
  },
  "dur": {
    "$type": "duration",
    "fast": {
      "$value": 100
    },
    "base": {
      "$value": 180
    },
    "slow": {
      "$value": 260
    },
    "slower": {
      "$value": 380
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "emphasized": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  },
  "icon": {
    "stroke": {
      "$type": "number",
      "$value": 1.25
    }
  }
}
