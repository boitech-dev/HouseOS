{
  "$schema": "../_schema/tokens.schema.json",
  "$description": "Modular: Swiss modular typography as a house. One grid of modules, black and white in duality, one signal red.",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Jersey 15",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Schibsted Grotesk",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Space Mono",
        "monospace"
      ]
    }
  },
  "text": {
    "$type": "typography",
    "display-xl": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 48,
        "fontWeight": 400,
        "lineHeight": 1.0,
        "letterSpacing": -0.01
      }
    },
    "display-l": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 37,
        "fontWeight": 400,
        "lineHeight": 1.0,
        "letterSpacing": -0.01
      }
    },
    "display-m": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 29,
        "fontWeight": 400,
        "lineHeight": 1.05
      }
    },
    "brand": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": 25,
        "fontWeight": 400,
        "lineHeight": 1.1
      }
    },
    "title-l": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 22,
        "fontWeight": 700,
        "lineHeight": 1.2,
        "letterSpacing": -0.01
      }
    },
    "title-m": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 18,
        "fontWeight": 700,
        "lineHeight": 1.25,
        "letterSpacing": -0.01
      }
    },
    "title-s": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 16,
        "fontWeight": 700,
        "lineHeight": 1.3
      }
    },
    "body-l": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 18,
        "fontWeight": 400,
        "lineHeight": 1.45
      }
    },
    "body-m": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 16,
        "fontWeight": 400,
        "lineHeight": 1.45
      }
    },
    "body-s": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 14,
        "fontWeight": 400,
        "lineHeight": 1.45
      }
    },
    "action": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 15,
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": 0.01
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": 0.09,
        "textTransform": "uppercase"
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": 12,
        "fontWeight": 500,
        "lineHeight": 1.35,
        "letterSpacing": 0.02
      }
    },
    "numeric": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": 13,
        "fontWeight": 400,
        "lineHeight": 1.3
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Squares and circles, nothing in between: boxes are square, chips and people are round.",
    "xs": {
      "$value": 0
    },
    "s": {
      "$value": 0
    },
    "m": {
      "$value": 0
    },
    "l": {
      "$value": 0
    },
    "xl": {
      "$value": 0
    },
    "control": {
      "$value": "{radius.none}"
    },
    "card": {
      "$value": "{radius.none}"
    },
    "sheet": {
      "$value": "{radius.none}"
    },
    "media": {
      "$value": "{radius.none}"
    },
    "chip": {
      "$value": "{radius.full}"
    },
    "avatar": {
      "$value": "{radius.full}"
    }
  },
  "elev": {
    "$type": "shadow",
    "$description": "No soft shadows: hierarchy comes from rules, black blocks and the red module.",
    "1": {
      "$value": "none"
    },
    "2": {
      "$value": "none"
    },
    "3": {
      "$value": "none"
    },
    "4": {
      "$value": "none"
    }
  },
  "material": {
    "surface": {
      "border": {
        "$value": "1px solid {color.border.default}"
      },
      "shadow": {
        "$value": "none"
      }
    },
    "raised": {
      "border": {
        "$value": "1px solid {color.border.strong}"
      },
      "shadow": {
        "$value": "inset 0 0 0 2px {color.fg.default}"
      }
    },
    "overlay": {
      "border": {
        "$value": "1px solid {color.border.strong}"
      },
      "shadow": {
        "$value": "none"
      }
    },
    "sunken": {
      "border": {
        "$value": "1px solid {color.border.strong}"
      }
    },
    "media": {
      "border": {
        "$value": "1px solid transparent"
      },
      "shadow": {
        "$value": "none"
      }
    },
    "paper": {
      "shadow": {
        "$value": "none"
      }
    }
  },
  "part": {
    "status": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.strong}"
      },
      "art-opacity": {
        "$type": "string",
        "$value": "1"
      }
    },
    "rail": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.strong}"
      }
    },
    "dock": {
      "border": {
        "$type": "string",
        "$value": "1px solid {color.border.strong}"
      }
    },
    "control": {
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "header": {
      "banner-wash": {
        "$type": "number",
        "$value": 0
      }
    },
    "nowbar": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.none}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "panel": {
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      },
      "texture": {
        "$type": "string",
        "$value": "linear-gradient({color.fg.default}, {color.fg.default}) top left / 8px 8px no-repeat"
      }
    },
    "sheet": {
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      },
      "texture": {
        "$type": "string",
        "$value": "linear-gradient({color.accent.solid}, {color.accent.solid}) top left / 48px 8px no-repeat, linear-gradient({color.fg.default}, {color.fg.default}) top left / 100% 8px no-repeat"
      }
    },
    "meter": {
      "track": {
        "$type": "color",
        "$value": "{color.bg.pressed}"
      },
      "thumb-radius": {
        "$type": "dimension",
        "$value": "{radius.full}"
      },
      "pattern": {
        "$type": "string",
        "$value": "repeating-linear-gradient(90deg, transparent 0 6px, {color.bg.canvas} 6px 8px)"
      }
    }
  },
  "dur": {
    "$type": "duration",
    "fast": {
      "$value": 80
    },
    "base": {
      "$value": 140
    },
    "slow": {
      "$value": 200
    },
    "slower": {
      "$value": 280
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "$description": "Snappy; things arrive in steps, like a module flipping.",
    "standard": {
      "$value": [
        0.7,
        0,
        0.2,
        1
      ]
    },
    "enter": {
      "$value": "steps(4)"
    },
    "exit": {
      "$value": [
        0.5,
        0,
        1,
        1
      ]
    },
    "emphasized": {
      "$value": "steps(3)"
    }
  },
  "icon": {
    "stroke": {
      "$type": "number",
      "$value": 2
    }
  }
}
