    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
